{
	"compilerOptions": {
		"moduleDetection": "force",
		"module": "Preserve",
		"resolveJsonModule": true,
		"allowJs": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"target": "es2017",		
		"baseUrl": ".",
		"paths": {
			"@db/*": [ "prisma/*" ],
			"@src/*": [ "src/*" ],
		},
		"experimentalDecorators": true
	},
}