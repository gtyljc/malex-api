generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  engineType      = "client"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum BwtChoice {
  WHATSAPP
  PHONE
  TEXT
}

enum Role {
  GUEST
  USER
  ADMIN
  SUPERUSER // backend
  SUPERADMIN
}

model Appointment {
  id           Int       @id @unique @default(autoincrement())
  name         String    @db.VarChar(50)
  surname      String    @db.VarChar(50)
  address      String    @db.VarChar(255)
  job_desc     String    @db.VarChar(500)
  bwt          BwtChoice
  phone_number String?   @db.VarChar(20)
  duration     Float
  date         DateTime  @unique @db.Timestamp(0)
  completed    Boolean   @default(false)
}

enum CategoryChoice {
  PLUMBING
  ASSEMBLING
  MOUNTING
}

model Work {
  id        Int            @id @unique @default(autoincrement())
  img_url   String         @unique @db.VarChar(2800)
  img_id    String         @unique @db.VarChar(50)
  category  CategoryChoice
  timestamp DateTime       @default(now()) @db.Timestamp(0)
}

model SiteConfig {
  id            Int      @id @unique @default(autoincrement()) @db.SmallInt
  opening_at    DateTime @db.Time(0)
  closing_at    DateTime @db.Time(0)
  min_duration  Float
  support_email String   @db.VarChar(50)
  phone_number  String   @db.VarChar(25)
  timezone      String   @db.VarChar(50)
  c_country     String   @db.VarChar(2)
}

model SuperAdmin {
  id    Int    @id @default(autoincrement()) @db.SmallInt
  admin Admin?
}

model Admin {
  id           Int      @id @default(autoincrement()) @db.SmallInt
  last_session DateTime @default(now()) @db.Timestamp(0)
  user         User?
  fullname     String   @db.VarChar(50)
  username     String   @db.VarChar(50)
  password     String   @db.VarChar(50)
  email        String   @db.VarChar(50)

  super_admin    SuperAdmin? @relation(fields: [super_admin_id], references: [id])
  super_admin_id Int?        @unique @db.SmallInt
}

model User {
  id       Int    @id @default(autoincrement())
  username String @db.VarChar(50)
  password String @db.VarChar(50)
  email    String @db.VarChar(50)
  fullname String @db.VarChar(50)

  admin    Admin? @relation(fields: [admin_id], references: [id])
  admin_id Int?   @unique
}
