generator client {
    provider   = "prisma-client-js"
    output     = "./generated"
    engineType = "client"
    previewFeatures = [ "typedSql" ]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum BwtChoice {
    WHATSAPP
    PHONE
    TEXT
}

enum Role {
    GUEST
    USER
    ADMIN
    SUPERUSER // backend
    SUPERADMIN
}

model Appointment {
    id           String    @id @default(nanoid(10))
    name         String    @db.VarChar(50)
    surname      String    @db.VarChar(50)
    address      String    @db.VarChar(255)
    job_desc     String    @db.VarChar(500)
    bwt          BwtChoice
    phone_number String?   @db.VarChar(20)
    duration     Float
    date         DateTime  @unique @db.Timestamptz(0)
    completed    Boolean   @default(false)
}

enum CategoryChoice {
    PLUMBING
    ASSEMBLING
    MOUNTING
}

model Work {
    id        String         @id @default(nanoid(16))
    img_url   String         @unique @db.VarChar(2800)
    img_id    String         @unique @db.VarChar(50)
    category  CategoryChoice
    timestamp DateTime       @default(now()) @db.Timestamptz(0)
}

model SiteConfig {
    id            String   @id @default("1")
    opening_at    DateTime @db.Timetz(0) @default(now()) 
    closing_at    DateTime @db.Timetz(0) @default(now())
    min_duration  Float    @default(0.5)
    support_email String   @default("support@malexhandy.com")
    phone_number  String   @default("3474101444")
    timezone      String   @default("America/New_York")
}

model Admin {
    id           String   @id @default(nanoid(16))
    username     String   @db.VarChar(50)
    password     String   @db.VarChar(50)
    email        String   @db.VarChar(50)
    fullname     String   @db.VarChar(50)
    is_logged    Boolean  @default(false)
    is_super     Boolean  @default(false)
    last_session DateTime @db.Timestamptz(0) @default(now())
}

model User {
    id       String @id @default(nanoid(16))
    username String @db.VarChar(50)
    password String @db.VarChar(50)
}

model RefreshToken {
    id         String   @id @default(nanoid(16))
    hash       String   @unique
    created_at DateTime @db.Timestamptz(0) @default(now()) 
    expired_at DateTime @db.Timestamptz(0)
    is_revoked Boolean  @default(false)
    role       Role
    user_id    String   @db.VarChar(16)
}
